{{!
    @template local_evidencehub/hub_matrix

    The hub's readiness matrix: the legend, one page of workers by the template's competencies, the pager.
    Rendered in full by the server with a fixed table layout, so nothing reflows after load.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-action="selectall" on the checkbox that selects every worker of the page
    * data-region="worker" on each worker's checkbox, which posts the worker's id as workers[]
    * data-action="inspect" on each cell's button, with data-userid, data-competencyid and data-title

    Context variables required for this template:
    * contextid, actionurl, sesskey, filterfields (name, value) - Where the selection of workers posts, with the
      filter it was made in.
    * canexport - Whether the viewer may export dossiers here: the "Export dossiers" button.
    * total - The worker count, as text.
    * legend - label, badgeclass of each effective status.
    * columncount, columns - id, name, kind (the policy's tag), kindlabel of each competency.
    * hasrows, rows - userid, workername, workerurl, selectlabel, identity (value), and cells: empty, or
      userid, competencyid, code, statuslabel, badgeclass, text, restricted, celllabel, drawertitle.
    * pagingbar - The pager, rendered by core.

    Example context (json):
    {
        "contextid": 1,
        "actionurl": "https://example.com/local/evidencehub/index.php",
        "sesskey": "abc123",
        "filterfields": [{"name": "templateid", "value": 5}, {"name": "view", "value": "matrix"}],
        "canexport": true,
        "total": "2 workers",
        "legend": [
            {"label": "Compliant", "badgeclass": "bg-success text-white"},
            {"label": "Expired", "badgeclass": "bg-dark text-white"}
        ],
        "columncount": 2,
        "columns": [
            {"id": 7, "name": "Work at height", "kind": "REG", "kindlabel": "Regulatory"},
            {"id": 8, "name": "Fire fighting", "kind": "TEC", "kindlabel": "Technical"}
        ],
        "hasrows": true,
        "rows": [
            {"userid": 12, "workername": "Ana Souza", "workerurl": "https://example.com/local/evidencehub/evidence.php?userid=12",
             "selectlabel": "Select Ana Souza", "identity": [{"value": "ana@example.com"}],
             "cells": [
                {"empty": false, "userid": 12, "competencyid": 7, "code": 5, "statuslabel": "Expired",
                 "badgeclass": "bg-dark text-white", "text": "−12 d", "restricted": false,
                 "celllabel": "Ana Souza: Work at height, Expired", "drawertitle": "Ana Souza: Work at height"},
                {"empty": false, "userid": 12, "competencyid": 8, "code": -1, "statuslabel": "Restricted",
                 "badgeclass": "bg-secondary text-dark", "text": "", "restricted": true,
                 "celllabel": "Ana Souza: Fire fighting, Restricted", "drawertitle": "Ana Souza: Fire fighting"}
             ]}
        ],
        "pagingbar": ""
    }
}}
<div class="local-evidencehub-matrix-view" data-region="local-evidencehub-matrix">
    <div class="local-evidencehub-legend d-flex flex-wrap align-items-center gap-3 mb-2" role="group"
        aria-label="{{#str}} hubmatrixlegend, local_evidencehub {{/str}}">
        {{#legend}}
        <span class="local-evidencehub-legend-item"><span class="local-evidencehub-swatch {{badgeclass}}"></span>{{label}}</span>
        {{/legend}}
        <span class="local-evidencehub-legend-kinds">{{#str}} hubmatrixkinds, local_evidencehub {{/str}}</span>
    </div>
    <form method="post" action="{{actionurl}}" class="local-evidencehub-matrix-form">
        <input type="hidden" name="contextid" value="{{contextid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        {{#filterfields}}
        <input type="hidden" name="{{name}}" value="{{value}}">
        {{/filterfields}}
        <p class="local-evidencehub-total">{{total}}</p>
        {{#hasrows}}
        <div class="local-evidencehub-matrix-scroll">
            <table class="table local-evidencehub-matrix" style="--local-evidencehub-matrix-columns: {{columncount}};">
                <thead>
                    <tr>
                        <th scope="col" class="local-evidencehub-matrix-worker">
                            <input type="checkbox" class="form-check-input me-2" data-action="selectall"
                                aria-label="{{#str}} hubmatrixselectall, local_evidencehub {{/str}}">
                            {{#str}} worker, local_evidencehub {{/str}}
                        </th>
                        {{#columns}}
                        <th scope="col" class="local-evidencehub-matrix-competency" data-competencyid="{{id}}">
                            <span class="local-evidencehub-matrix-name">{{name}}</span>
                            <abbr class="local-evidencehub-kind" title="{{kindlabel}}">{{kind}}</abbr>
                        </th>
                        {{/columns}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr data-userid="{{userid}}">
                        <th scope="row" class="local-evidencehub-matrix-worker">
                            <div class="d-flex align-items-start">
                                <input type="checkbox" class="form-check-input me-2 flex-shrink-0" data-region="worker"
                                    name="workers[]" value="{{userid}}" aria-label="{{selectlabel}}">
                                <div class="local-evidencehub-matrix-who">
                                    <a href="{{workerurl}}">{{workername}}</a>
                                    {{#identity}}
                                    <small class="d-block local-evidencehub-matrix-identity">{{value}}</small>
                                    {{/identity}}
                                </div>
                            </div>
                        </th>
                        {{#cells}}
                        <td class="local-evidencehub-matrix-cell">
                            {{^empty}}
                            <button type="button" class="local-evidencehub-cell {{badgeclass}}" data-action="inspect" data-status="{{code}}"
                                data-userid="{{userid}}" data-competencyid="{{competencyid}}" data-title="{{drawertitle}}"
                                aria-label="{{celllabel}}">
                                <span class="visually-hidden">{{statuslabel}}</span>
                                {{#restricted}}{{#pix}} t/locked, core {{/pix}}{{/restricted}}
                                {{text}}
                            </button>
                            {{/empty}}
                        </td>
                        {{/cells}}
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        <p class="form-text">{{#str}} hubmatrixhelp, local_evidencehub {{/str}}</p>
        {{{pagingbar}}}
        {{#canexport}}
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="submit" name="action" value="exportdossiers" class="btn btn-primary"
                data-action="exportdossiers">{{#str}} dossierexport, local_evidencehub {{/str}}</button>
            <span class="form-text">{{#str}} dossierexporthelp, local_evidencehub {{/str}}</span>
        </div>
        {{/canexport}}
        {{/hasrows}}
        {{^hasrows}}
        <p class="text-muted">{{#str}} hubmatrixnorows, local_evidencehub {{/str}}</p>
        {{/hasrows}}
    </form>
</div>
