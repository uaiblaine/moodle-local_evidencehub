{{!
    @template local_evidencehub/verify_page

    The public verification page of a readiness dossier: its snapshot as issued, or only the revocation
    once it is revoked; never an identifier, a full name or a file.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * actionurl - Where the code form goes.
    * notfound - A code was given and names no dossier (or is not a code at all).
    * found - The code names a dossier; everything below belongs to it.
    * revoked, revokedon - Whether and when the dossier was revoked; a revoked one carries nothing else below.
    * name - The masked name, e.g. "J*** S***".
    * template, issued - The learning plan template and the issue date.
    * hasreadiness - Whether the snapshot states the verdict the site's readiness basis asks for.
    * readiness, readinessclass - That verdict and its badge classes; read only with hasreadiness.
    * pdfhash, code - The SHA-256 of the issued PDF, and the verification code.
    * live - Whether each competency also shows its current status.
    * competencies - name, statuslabel, badgeclass, expiry (as at issuance), and livelabel, livebadgeclass.

    Example context (json):
    {
        "actionurl": "https://example.com/local/evidencehub/verify.php",
        "notfound": false,
        "found": true,
        "name": "J*** S***",
        "template": "Electricians",
        "issued": "29 October 2026",
        "hasreadiness": true,
        "readiness": "Ready",
        "readinessclass": "bg-success text-white",
        "revoked": false,
        "revokedon": "",
        "pdfhash": "4be1c0ffee",
        "code": "9f3a7c2104bde71c9f3a7c2104bde71c",
        "live": true,
        "competencies": [
            {"name": "Work at height", "statuslabel": "Compliant", "badgeclass": "bg-success text-white",
             "expiry": "2027-11-16", "livelabel": "Due soon", "livebadgeclass": "bg-warning text-dark"}
        ]
    }
}}
<div class="local-evidencehub-verify" data-region="local-evidencehub-verify">
    {{#notfound}}
    <div class="alert alert-warning">{{#str}} verifynotfound, local_evidencehub {{/str}}</div>
    {{/notfound}}
    {{#found}}
    {{#revoked}}
    <div class="alert alert-danger local-evidencehub-verify-revoked">{{#str}} verifyrevoked, local_evidencehub, {{revokedon}} {{/str}}</div>
    {{/revoked}}
    {{^revoked}}
    <div class="alert alert-success">{{#str}} verifyauthentic, local_evidencehub {{/str}}</div>
    <dl class="row local-evidencehub-verify-facts">
        <dt class="col-sm-4">{{#str}} worker, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8 local-evidencehub-verify-name">{{name}}</dd>
        <dt class="col-sm-4">{{#str}} template, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8">{{template}}</dd>
        <dt class="col-sm-4">{{#str}} dossierissued, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8">{{issued}}</dd>
        {{#hasreadiness}}
        <dt class="col-sm-4">{{#str}} dossierreadiness, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8"><span class="badge {{readinessclass}}">{{readiness}}</span></dd>
        {{/hasreadiness}}
        <dt class="col-sm-4">{{#str}} verifycode, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8 local-evidencehub-verify-hash">{{code}}</dd>
        <dt class="col-sm-4">{{#str}} verifypdfhash, local_evidencehub {{/str}}</dt>
        <dd class="col-sm-8 local-evidencehub-verify-hash">{{pdfhash}}</dd>
    </dl>
    <table class="table generaltable local-evidencehub-verify-table">
        <thead>
            <tr>
                <th scope="col">{{#str}} competency, local_evidencehub {{/str}}</th>
                <th scope="col">{{#str}} verifystatusatissue, local_evidencehub {{/str}}</th>
                <th scope="col">{{#str}} effectiveexpiry, local_evidencehub {{/str}}</th>
                {{#live}}
                <th scope="col">{{#str}} verifystatusnow, local_evidencehub {{/str}}</th>
                {{/live}}
            </tr>
        </thead>
        <tbody>
            {{#competencies}}
            <tr>
                <td>{{name}}</td>
                <td><span class="badge {{badgeclass}}">{{statuslabel}}</span></td>
                <td>{{expiry}}</td>
                {{#live}}
                <td><span class="badge {{livebadgeclass}}">{{livelabel}}</span></td>
                {{/live}}
            </tr>
            {{/competencies}}
        </tbody>
    </table>
    <p class="form-text">{{#str}} verifynote, local_evidencehub {{/str}}</p>
    {{/revoked}}
    {{/found}}
    <form method="get" action="{{actionurl}}" class="local-evidencehub-verify-form row g-2 align-items-end mt-3">
        <div class="col-md-6">
            <label for="local-evidencehub-verify-code-{{uniqid}}" class="form-label">{{#str}} verifycode, local_evidencehub {{/str}}</label>
            <input type="text" id="local-evidencehub-verify-code-{{uniqid}}" name="code" class="form-control" maxlength="32"
                autocomplete="off">
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-secondary">{{#str}} verifycheck, local_evidencehub {{/str}}</button>
        </div>
    </form>
</div>
