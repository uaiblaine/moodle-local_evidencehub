{{!
    @template local_evidencehub/drawer

    The inspection drawer's frame: core's modal with the side-sheet class on its dialog from creation,
    so the first opening already slides in.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * title - The drawer's title.
    * body - The body, loaded later through core/fragment.

    Example context (json):
    {
        "title": "Ana Souza: Work at height",
        "body": ""
    }
}}
{{< core/modal }}
    {{$classes}}local-evidencehub-drawer{{/classes}}
{{/ core/modal }}
