{{!
    @template local_evidencehub/evidence_page

    A worker's evidence of prior learning with its validity details.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local-evidencehub-evidence", data-userid
    * data-action="add|edit|complete|verify" with data-id on the buttons

    Context variables required for this template:
    * userid - The worker.
    * canadd - Whether the viewer may add evidence.
    * hasitems - Whether there is any evidence.
    * items - The evidence, see local_evidencehub/evidence_item.
    * hasdossiers, dossiers - The dossiers issued about the worker: id, created, createdby, template, revoked,
      revokedon, canrevoke, revokelabel.
    * actionurl, sesskey - Where a revocation posts.

    Example context (json):
    {
        "userid": 3,
        "canadd": true,
        "hasitems": true,
        "items": [
            {
                "id": 7,
                "name": "First aid certificate",
                "viewurl": "https://example.com/admin/tool/lp/user_evidence.php?id=7",
                "canedit": true,
                "hasdetails": true,
                "cancomplete": false,
                "canverify": true,
                "metaid": 4,
                "typename": "Regulatory training certificate (NR)",
                "restricted": false,
                "statelabel": "Verified",
                "badgeclass": "bg-success text-white",
                "decidedby": "By Ana Souza on 30/10/26, 10:00",
                "issuedate": "2026-01-15",
                "expirydate": "2028-01-15",
                "noexpiry": false,
                "issuer": "Training centre",
                "hours": "8",
                "authcode": "ABC-123",
                "note": "Checked against the file.",
                "hascompetencies": true,
                "competencies": [
                    {
                        "name": "Work at height",
                        "statuslabel": "Compliant",
                        "badgeclass": "bg-success text-white",
                        "expiry": "2028-01-15"
                    }
                ]
            }
        ],
        "hasdossiers": true,
        "dossiers": [
            {"id": 5, "created": "29/10/26, 14:32", "createdby": "Carla Menezes", "template": "Electricians",
             "revoked": false, "revokedon": "", "canrevoke": true,
             "revokelabel": "Revoke the dossier for Electricians of 29/10/26, 14:32"}
        ],
        "actionurl": "https://example.com/local/evidencehub/evidence.php?userid=3",
        "sesskey": "abc123"
    }
}}
<div class="local-evidencehub-evidence" data-region="local-evidencehub-evidence" data-userid="{{userid}}">
    {{#canadd}}
    <div class="mb-3">
        <button type="button" class="btn btn-primary" data-action="add">{{#str}} actionadd, local_evidencehub {{/str}}</button>
    </div>
    {{/canadd}}
    {{#hasitems}}
    <div class="local-evidencehub-items">
        {{#items}}
        {{> local_evidencehub/evidence_item}}
        {{/items}}
    </div>
    {{/hasitems}}
    {{^hasitems}}
    <p class="text-muted">{{#str}} noevidence, local_evidencehub {{/str}}</p>
    {{/hasitems}}

    <section class="local-evidencehub-shared mt-4" aria-labelledby="local-evidencehub-shared-{{uniqid}}">
        <h3 id="local-evidencehub-shared-{{uniqid}}" class="h5">{{#str}} shareddossiers, local_evidencehub {{/str}}</h3>
        {{#hasdossiers}}
        <table class="table generaltable local-evidencehub-shared-table">
            <thead>
                <tr>
                    <th scope="col">{{#str}} shareddossierswhen, local_evidencehub {{/str}}</th>
                    <th scope="col">{{#str}} shareddossiersby, local_evidencehub {{/str}}</th>
                    <th scope="col">{{#str}} template, local_evidencehub {{/str}}</th>
                    <th scope="col">{{#str}} status, local_evidencehub {{/str}}</th>
                    <th scope="col"><span class="visually-hidden">{{#str}} dossierrevoke, local_evidencehub {{/str}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#dossiers}}
                <tr data-dossierid="{{id}}">
                    <td>{{created}}</td>
                    <td>{{createdby}}</td>
                    <td>{{template}}</td>
                    <td>
                        {{#revoked}}<span class="badge bg-danger text-white">{{#str}} dossierrevokedon, local_evidencehub, {{revokedon}} {{/str}}</span>{{/revoked}}
                        {{^revoked}}<span class="badge bg-success text-white">{{#str}} dossiervalid, local_evidencehub {{/str}}</span>{{/revoked}}
                    </td>
                    <td>
                        {{#canrevoke}}
                        <form method="post" action="{{actionurl}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="revokedossier">
                            <input type="hidden" name="dossierid" value="{{id}}">
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                aria-label="{{revokelabel}}">{{#str}} dossierrevoke, local_evidencehub {{/str}}</button>
                        </form>
                        {{/canrevoke}}
                    </td>
                </tr>
                {{/dossiers}}
            </tbody>
        </table>
        {{/hasdossiers}}
        {{^hasdossiers}}
        <p class="text-muted">{{#str}} shareddossiersnone, local_evidencehub {{/str}}</p>
        {{/hasdossiers}}
    </section>
</div>
