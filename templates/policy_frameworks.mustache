{{!
    @template local_evidencehub/policy_frameworks

    The competency frameworks whose validity policies the user may manage.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasframeworks - Whether there is any.
    * frameworks - id, name, idnumber, contextname and url of each.

    Example context (json):
    {
        "hasframeworks": true,
        "frameworks": [
            {
                "id": 2,
                "name": "Safety at work",
                "idnumber": "SAFETY",
                "contextname": "Operations",
                "url": "https://example.com/local/evidencehub/policies.php?frameworkid=2"
            }
        ]
    }
}}
<div class="local-evidencehub-frameworks">
    {{#hasframeworks}}
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}} framework, local_evidencehub {{/str}}</th>
                <th scope="col">{{#str}} idnumber {{/str}}</th>
                <th scope="col">{{#str}} context {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#frameworks}}
            <tr>
                <td><a href="{{url}}">{{name}}</a></td>
                <td>{{idnumber}}</td>
                <td>{{contextname}}</td>
            </tr>
            {{/frameworks}}
        </tbody>
    </table>
    {{/hasframeworks}}
    {{^hasframeworks}}
    <p class="text-muted">{{#str}} nopolicyframeworks, local_evidencehub {{/str}}</p>
    {{/hasframeworks}}
</div>
